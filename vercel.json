{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/public/chat/(.*)",
      "destination": "https://os.4chairs.bg/api/v1/public/chat/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
